<%- include('partials/header') %>
<main class="new-organization">
    <h1><%= title %></h1>
    <p class="form-intro">
        Add a new partner organization to the directory. All fields are required.
    </p>

    <form action="/new-organization" method="POST">
        <div class="form-group">
            <label for="name">Organization Name <span class="required">*</span></label>
            <input
                type="text"
                id="name"
                name="name"
                placeholder="e.g., Riverside Community Builders"
                required
                maxlength="150"
            />
        </div>

        <div class="form-group">
            <label for="description">Description <span class="required">*</span></label>
            <textarea
                id="description"
                name="description"
                placeholder="What does this organization do?"
                required
                maxlength="500"
            ></textarea>
        </div>

        <div class="form-group">
            <label for="contactEmail">Contact Email <span class="required">*</span></label>
            <input
                type="email"
                id="contactEmail"
                name="contactEmail"
                placeholder="contact@example.org"
                required
            />
        </div>

        <div class="form-actions">
            <button type="submit">Create Organization</button>
            <a href="/organizations" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</main>
<%- include('partials/footer') %>