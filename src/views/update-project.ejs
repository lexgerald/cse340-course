<%- include('partials/header') %>
<main class="project-form-page">
    <section class="project-form-card">
        <header class="form-card-header">
            <h1><%= title %></h1>
            <p class="form-intro">Update the project details below.</p>
        </header>

        <form action="/edit-project/<%= projectDetails.project_id %>" method="POST" class="project-form">
            <div class="form-group">
                <label for="title">Project Title <span class="required">*</span></label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    value="<%= projectDetails.title %>"
                    maxlength="200"
                    minlength="3"
                    required
                />
            </div>

            <div class="form-group">
                <label for="description">Description <span class="required">*</span></label>
                <textarea
                    id="description"
                    name="description"
                    maxlength="1000"
                    required
                ><%= projectDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location <span class="required">*</span></label>
                <input
                    type="text"
                    id="location"
                    name="location"
                    value="<%= projectDetails.location %>"
                    maxlength="200"
                    required
                />
            </div>

            <div class="form-group">
                <label for="date">Date <span class="required">*</span></label>
                <input
                    type="date"
                    id="date"
                    name="date"
                    value="<%= new Date(projectDetails.date).toISOString().split('T')[0] %>"
                    required
                />
            </div>

            <div class="form-group">
                <label for="organizationId">Organization <span class="required">*</span></label>
                <select
                    id="organizationId"
                    name="organizationId"
                    required
                >
                    <% organizations.forEach(org => { %>
                        <option
                            value="<%= org.organization_id %>"
                            <%= org.organization_id === projectDetails.organization_id ? 'selected' : '' %>
                        ><%= org.name %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update Project</button>
                <a href="/project/<%= projectDetails.project_id %>" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </section>
</main>
<%- include('partials/footer') %>