<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h3>Browse organizations by category</h3>
    <% if (categories && categories.length > 0) { %>
        <ul class="category-list">
            <% categories.forEach(category => { %>
                <li><%= category.name %></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories found.</p>
    <% } %>
</main>
<%- include('partials/footer') %>