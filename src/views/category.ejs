<%- include('partials/header') %>
<main>
    <h1><%= category.name %></h1>

    <h3>Service Projects in this Category</h3>

    <% if (typeof projects === 'undefined' || projects.length === 0) { %>
        <p>No projects in this category yet.</p>
    <% } else { %>
        <ul>
            <% projects.forEach((project) => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a><br>
                    (<%= project.organization_name %>) <br>
                    <%= new Date(project.date).toISOString().split('T')[0] %>
                </li>
            <% }) %>
        </ul>
    <% } %>

    <p>
        <a href="/categories" class="btn btn-ghost">← Back to Categories</a>
        <a href="/edit-category/<%= category.category_id %>" class="btn btn-ghost">Edit Category</a>
    </p>
</main>
<%- include('partials/footer') %>