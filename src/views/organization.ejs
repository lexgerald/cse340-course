<%- include('partials/header') %>
<main>
    <p>
        <a href="/organizations" class="btn btn-ghost">← Back to Organizations</a>
        <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-organization/<%= organization.organization_id %>" class="btn btn-ghost">Edit Organization</a>
        <% } %>
    </p>
    
    <h1><%= organization.name %></h1>
    <img
        src="/images/<%= organization.logo_filename %>"
        alt="<%= organization.name %> logo"
        class="organization-logo"
    />

    <p><%= organization.description %></p>

    <p>
        <strong>Contact:</strong>
        <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
    </p>

</main>
<%- include('partials/footer') %>