<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (typeof categories === 'undefined' || categories.length === 0) { %>
        <p>No categories found.</p>
    <% } else { %>
        <ul>
            <% categories.forEach((category) => { %>
                <li>
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                </li>
            <% }) %>
        </ul>
    <% } %>
</main>
<%- include('partials/footer') %>