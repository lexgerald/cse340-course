<%- include('partials/header') %>
<main>
    <p>
        <a href="/projects" class="btn btn-ghost">← Back to Projects</a>
        <% if (user && user.role_name === 'admin') { %>
        <a href="/assign-categories/<%= project.project_id %>" class="btn btn-ghost">Edit Categories</a>
        <% } %>
        <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-project/<%= project.project_id %>" class="btn btn-ghost">Edit Project</a>
        <% } %>
    </p>
    <h1><%= project.title %></h1>
    <p><%= project.description %></p>

    <p><strong>Date:</strong> <%= new Date(project.date).toISOString().split('T')[0] %></p>

    <p><strong>Location:</strong> <%= project.location %></p>

    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
        <%= project.organization_name %></a>
    </p>

    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
        <p>
            <strong>Categories:</strong>
            <% categories.forEach((category, index) => { %>
                <a href="/category/<%= category.category_id %>">
                <%= category.name %></a>
                <%= index < categories.length - 1 ? ', ' : '' %>
            <% }) %>
        </p>
    <% } %>

</main>
<%- include('partials/footer') %>