<%- include('partials/header') %>
<main class="organization-form-page">
    <section class="organization-form-card">
        <header class="form-card-header">
            <h1><%= title %></h1>
            <p class="form-intro">Update the category name below.</p>
        </header>

        <form action="/edit-category/<%= categoryDetails.category_id %>" method="POST" class="organization-form">
            <div class="form-group">
                <label for="name">Category Name <span class="required">*</span></label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= categoryDetails.name %>"
                    maxlength="100"
                    required
                />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update Category</button>
                <a href="/category/<%= categoryDetails.category_id %>" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </section>
</main>
<%- include('partials/footer') %>