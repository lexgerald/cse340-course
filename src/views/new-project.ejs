<%- include('partials/header') %>
<main class="project-form-page">
    <section class="project-form-card">
        <header class="form-card-header">
            <h1><%= title %></h1>
            <p class="form-intro">
                Add a new service project to the directory. Fields marked with
                <span class="required">*</span> are required.
            </p>
        </header>

        <form action="/new-project" method="POST" class="project-form">
            <div class="form-group">
                <label for="title">Project Title <span class="required">*</span></label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    maxlength="150"
                    placeholder="e.g., Community Center Renovation"
                    required
                />
            </div>

            <div class="form-group">
                <label for="description">Description <span class="required">*</span></label>
                <textarea
                    id="description"
                    name="description"
                    maxlength="500"
                    placeholder="What will this project involve?"
                    required
                ></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location <span class="required">*</span></label>
                <input
                    type="text"
                    id="location"
                    name="location"
                    maxlength="255"
                    placeholder="e.g., Riverside Community Center"
                    required
                />
            </div>

            <div class="form-group">
                <label for="date">Date <span class="required">*</span></label>
                <input
                    type="date"
                    id="date"
                    name="date"
                    required
                />
                <small class="form-hint">The date the project is scheduled to take place.</small>
            </div>

            <div class="form-group">
                <label for="organizationId">Organization <span class="required">*</span></label>
                <select
                    id="organizationId"
                    name="organizationId"
                    required
                >
                    <option value="">— Select an organization —</option>
                    <% organizations.forEach(org => { %>
                        <option value="<%= org.organization_id %>"><%= org.name %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Project</button>
                <a href="/projects" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </section>
</main>
<%- include('partials/footer') %>