<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h3>Upcoming Service Projects</h3>
    <ul>
        <% serviceProjects.forEach((project) => { %>
            <li>
                <%= project.project_date.toISOString().split('T')[0] %>:
                <%= project.title %> (<%= project.organization_id %>)
            </li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>