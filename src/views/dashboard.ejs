<%- include('partials/header') %>

<main class="dashboard-page">
    <section class="dashboard-card">
        <header class="dashboard-header">
            <h1><%= title %></h1>
            <p class="dashboard-welcome">Welcome back, <strong><%= name %></strong>.</p>
        </header>

        <div class="dashboard-info">
            <div class="info-row">
                <span class="info-label">Name</span>
                <span class="info-value"><%= name %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Email</span>
                <span class="info-value"><%= email %></span>
            </div>
        </div><br>

        <% if (roleName === 'admin') { %>
            <div class="dashboard-actions">
                <a href="/users" class="btn btn-primary">View All Users</a>
            </div>
        <% } %>

        <section class="dashboard-volunteer-section">
            <h2>My Volunteer Projects</h2>

            <% if (typeof volunteeredProjects === 'undefined' || volunteeredProjects.length === 0) { %>
                <p class="dashboard-empty">
                    You haven't signed up to volunteer for any projects yet.
                    <a href="/projects">Browse upcoming projects →</a>
                </p>
            <% } else { %>
                <ul class="volunteer-list">
                    <% volunteeredProjects.forEach(project => { %>
                        <li class="volunteer-item">
                            <div class="volunteer-info">
                                <a href="/project/<%= project.project_id %>" class="volunteer-title">
                                    <%= project.title %>
                                </a>
                                <span class="volunteer-meta">
                                    <%= new Date(project.date).toISOString().split('T')[0] %>
                                    · <%= project.location %>
                                    · <%= project.organization_name %>
                                </span>
                            </div>
                            <form action="/project/<%= project.project_id %>/unvolunteer" method="POST" class="volunteer-remove-form">
                                <button type="submit" class="btn btn-ghost btn-sm">Remove</button>
                            </form>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </section>
    </section>
</main>

<%- include('partials/footer') %>